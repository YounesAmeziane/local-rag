# Copy to .env and fill in. All values are read by config.py.

# ── SQL Server ────────────────────────────────────────────────────────────────
# REQUIRED — no default. Startup fails loud if unset (audit #10) rather than
# silently pointing at localhost. Use the server\instance name or host.
DB_SERVER=YOUR_SQL_SERVER
DB_DATABASE=MetadataRepository
DB_DRIVER=ODBC Driver 17 for SQL Server

# Multi-step planner: schemas the enumeration tools refuse to list (comma-separated).
PLANNER_SCHEMA_DENYLIST=sys,INFORMATION_SCHEMA,guest

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Use 127.0.0.1, NOT "localhost": on Windows "localhost" resolves to IPv6 ::1
# first and stalls ~2s per call before falling back to IPv4 (audit #1).
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
