# Server .env — copy to .env on the Windows Server, in the repo root.
# Same variables config.py already reads (see README.md §12 for the full
# reference) -- this file just fills in server-context defaults. The
# repo-root .env.example stays the local-dev version (LM Studio, DB_POOL_SIZE
# unset/default) -- don't overwrite it with this.

# ── SQL Server ────────────────────────────────────────────────────────────────
DB_SERVER=YOUR_SQL_SERVER
DB_DATABASE=MetadataRepository
DB_DRIVER=ODBC Driver 17 for SQL Server

# Run sql/create_readonly_login.sql against the target SQL Server first (if not
# already done), then fill these in. Once both are set, sql_generator/planner/
# ingest.py all connect as this login instead of the service's Windows identity
# (config.py warns at startup if only one of the two is set).
DB_READONLY_USER=rag_readonly
DB_READONLY_PASSWORD=CHANGE_ME_TO_THE_PASSWORD_SET_IN_create_readonly_login.sql

# Concurrent SQL connections the pool (db_pool.py) will hold. Raise if you
# expect many simultaneous users triggering SQL-route questions.
DB_POOL_SIZE=10

# ── Qdrant ────────────────────────────────────────────────────────────────────
# 127.0.0.1 if Qdrant runs on this same server (the recommended setup -- see
# ops/install_qdrant_service.ps1); a real host if it's on a separate box.
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Chat / reasoning model ──────────────────────────────────────────────────────
# Ollama, not LM Studio, on the server (see ops/setup_ollama.ps1 for why).
# Same OpenAI-compatible /v1 shape llm.py already targets -- no code change.
REASON_BASE_URL=http://127.0.0.1:11434/v1
REASON_MODEL=qwen3.8-27b
REASON_TIMEOUT=600
REASONING_EFFORT=low

# ── Embeddings (always Ollama, regardless of REASON_BASE_URL) ──────────────────
OLLAMA_HOST=http://127.0.0.1:11434

# ── Hybrid retrieval (documents corpus) -- same defaults as local dev ──────────
HYBRID_SEARCH=1
HYBRID_STRUCTURED=0

# ── Access control ──────────────────────────────────────────────────────────────
RESTRICTED_DOC_PATTERNS=fha_hr_data,fha_leave_policy
APP_CLEARANCE=general

# ── Web UI ────────────────────────────────────────────────────────────────────
# webui.py's HOST is hardcoded 127.0.0.1 in code, not env-configurable -- this
# only sets the port. Making it reachable from other machines needs a code
# change (bind 0.0.0.0) plus at minimum a shared-token guard, neither of which
# exists yet. See SERVER_MIGRATION.md "Not solved here" before changing that.
WEBUI_PORT=8080
